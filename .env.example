# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
DATABASE_URL=postgresql://realife:realife@localhost:5432/realife

# Companion media/listing backend
NEXT_PUBLIC_API_BASE=http://localhost:3001
NEXT_PUBLIC_AI_API_BASE=http://localhost:3001

# ---------------------------------------------------------------------------
# Base Sepolia and wallet connections
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=84532
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
RPC_URL=https://sepolia.base.org

NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# Verify every address against the intended Base Sepolia deployment.
NEXT_PUBLIC_REALIFE_1155_NEW_CONTRACT=
NEXT_PUBLIC_REALIFE_PROTECTED_1155_ADDRESS=
NEXT_PUBLIC_REALIFE_1155_DELIVERY_CONTRACT=
NEXT_PUBLIC_REALIFE_MARKETPLACE_STANDARD_ADDRESS=
NEXT_PUBLIC_REALIFE_PROTECTED_MARKETPLACE_USDC_CONTRACT=
NEXT_PUBLIC_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_TREASURY_ADDRESS=

# Server-side aliases used by indexers and API routes
REALIFE_1155_NEW_CONTRACT=
REALIFE_PROTECTED_1155_ADDRESS=
REALIFE_1155_DELIVERY_CONTRACT=
REALIFE_MARKETPLACE_STANDARD_ADDRESS=
REALIFE_PROTECTED_MARKETPLACE_USDC_CONTRACT=
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# AI systems (server only)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_AI_SUGGEST_MODEL=gpt-5.4-mini
OPENAI_NFT_ENRICH_MODEL=gpt-4.1-mini
OPENAI_TRADING_SEARCH_MODEL=gpt-5.4-mini
OPENAI_ORDER_ASSIST_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VIDEO_MODEL=sora-2

OPENAI_NFT_ENRICH_IMAGE_DETAIL=high
OPENAI_NFT_ENRICH_MAX_IMAGE_BYTES=12000000
OPENAI_NFT_ENRICH_IMAGE_FETCH_TIMEOUT_MS=15000
OPENAI_NFT_ENRICH_TIMEOUT_MS=90000
OPENAI_NFT_ENRICH_ITEM_TIMEOUT_MS=120000
OPENAI_NFT_ENRICH_USE_REMOTE_URL=0
AI_ENRICH_BATCH_SECRET=
AI_ENRICH_CRON_LIMIT=10

# ---------------------------------------------------------------------------
# IPFS/media
# ---------------------------------------------------------------------------
IPFS_GATEWAY_ORIGIN=https://nftstorage.link
IPFS_GATEWAY_PRIMARY=https://nftstorage.link
NEXT_PUBLIC_IPFS_GATEWAY=https://nftstorage.link

# ---------------------------------------------------------------------------
# Optional authentication, email, and social providers
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
NEXTAUTH_DEBUG=false

# ---------------------------------------------------------------------------
# Optional admin/support access — use unique high-entropy secrets
# ---------------------------------------------------------------------------
ADMIN_CREATE_WALLETS=
ADMIN_PANEL_LOGIN=
ADMIN_PANEL_PASSWORD=
ADMIN_PANEL_TTL_HOURS=12
ADMIN_SESSION_SECRET=
ADMIN_ESCROW_LOGIN=
ADMIN_ESCROW_PASSWORD=
ADMIN_ESCROW_TTL_HOURS=12
ADMIN_ESCROW_COOKIE_SECRET=
ADMIN_ESCROW_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional faucet — never use a wallet that controls production funds
# ---------------------------------------------------------------------------
FAUCET_PRIVATE_KEY=
FAUCET_ETH_AMOUNT=0.0001
FAUCET_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
FAUCET_USDC_AMOUNT=1
FAUCET_COOLDOWN_HOURS=24
FAUCET_MAX_CLAIMS_PER_IP_PER_DAY=3
FAUCET_IP_HASH_SECRET=
NEXT_PUBLIC_FAUCET_ETH_LABEL=Base Sepolia ETH
NEXT_PUBLIC_FAUCET_USDC_LABEL=Base Sepolia USDC

# ---------------------------------------------------------------------------
# Optional indexer tuning
# ---------------------------------------------------------------------------
CONFIRMATIONS=2
BATCH_BLOCKS=2000
LOOKBACK_BLOCKS=10000
SLEEP_MS=5000
START_BLOCK=
STANDARD_MARKETPLACE_START_BLOCK=
STANDARD_MARKETPLACE_CONFIRMATIONS=2
STANDARD_MARKETPLACE_BATCH_BLOCKS=2000
STANDARD_MARKETPLACE_LOOKBACK_BLOCKS=10000
STANDARD_MARKETPLACE_SLEEP_MS=5000
PROTECTED_MARKETPLACE_START_BLOCK=
