    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "framer-motion": "12.42.2",
    "geist": "1.7.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.0",
    "swiper": "^12.1.2",
    "tailwind-merge": "3.6.0",
