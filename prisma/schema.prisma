generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ========================================================================== */
/* USER                                                                       */
/* ========================================================================== */

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /* ---------------- Public profile ---------------- */
  handle   String? @unique
  publicId String? @unique

  /* ---------------- Wallet (primary identity) ---------------- */
  walletAddress String @unique
  walletChainId Int?

  /* ---------------- Referrals ---------------- */
  referralCode String? @unique
  referredById String?
  referredAt   DateTime?

  // who referred me
  referredBy User? @relation("UserReferrals", fields: [referredById], references: [id])

  // users I referred
  referrals  User[] @relation("UserReferrals")

  /* ---------------- X (Twitter) ---------------- */
  twitterId       String?  @unique
  twitterName     String?
  twitterUser     String?
  twitterImage    String?
  twitterRewarded Boolean @default(false) // ⛔ anti-abuse

  /* ---------------- Discord ---------------- */
  discordId       String?  @unique
  discordName     String?
  discordUser     String?
  discordImage    String?
  discordRewarded Boolean @default(false) // ⛔ anti-abuse

  /* ---------------- Points & rewards ---------------- */
  points      Int       @default(0)
  lastDailyAt DateTime?

  events PointEvent[]

  /* ---------------- Minted NFTs ---------------- */
  mints Mint[]

  @@index([twitterUser])
  @@index([discordUser])
  @@index([referralCode])
  @@index([referredById])
}

/* ========================================================================== */
/* WALLET NONCE (SIWE-like)                                                    */
/* ========================================================================== */

model WalletNonce {
  address   String   @id // lowercased wallet (у тебя тут еще используется как ref:... key)
  nonce     String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/* ========================================================================== */
/* POINT EVENTS (ledger / history)                                             */
/* ========================================================================== */

model PointEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String   // "daily", "twitter_connect", "discord_connect", "REFERRAL_INVITER", "REFERRAL_JOINER", etc
  points Int
  meta   Json?

  // для idempotency рефералок (кто был “второй стороной”)
  refUserId String?

  @@index([userId])
  @@index([type])

  // idempotent начисления для referrals:
  // (userId + type + refUserId) уникальны
  @@unique([userId, type, refUserId])
}

/* ========================================================================== */
/* TEMP STORAGE FOR X OAUTH LINKING                                            */
/* Prevents creating second user during OAuth callback                        */
/* ========================================================================== */

model TwitterLinkAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // NextAuth session cookie value
  sessionToken String

  twitterId    String
  twitterUser  String?
  twitterName  String?
  twitterImage String?

  @@index([sessionToken])
  @@index([createdAt])
  @@index([twitterId])
}

/* ========================================================================== */
/* MINTED NFT CACHE (for profile display)                                      */
/* ========================================================================== */

model Mint {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  chainId  Int
  contract String
  tokenId  String

  txHash   String? @unique
  tokenUri String?
  name     String?
  image    String?

  verified Boolean @default(true)

  @@unique([chainId, contract, tokenId])
  @@index([userId, createdAt])
}