generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ==========================================================================
 */
/**
 * ENUMS
 */
/**
 * ==========================================================================
 */

enum NftStandard {
  ERC721
  ERC1155
}

enum ListingStatus {
  ACTIVE
  CANCELLED
  SOLD_OUT
}

enum EscrowStatus {
  NOT_REQUIRED
  PENDING
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum DeliveryStatus {
  NOT_REQUIRED
  PENDING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CONFIRMED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

/**
 * ==========================================================================
 */
/**
 * USER
 */
/**
 * ==========================================================================
 */

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * ---------------- Public profile ----------------
   */
  handle   String? @unique
  publicId String? @unique

  /**
   * ---------------- Wallet (primary identity) ----------------
   */
  walletAddress String @unique
  walletChainId Int?

  /**
   * ---------------- Referrals ----------------
   */
  referralCode String?   @unique
  referredById String?
  referredAt   DateTime?

  referredBy User? @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  User[] @relation("UserReferrals")

  /**
   * ---------------- X (Twitter) ----------------
   */
  twitterId       String? @unique
  twitterName     String?
  twitterUser     String?
  twitterImage    String?
  twitterRewarded Boolean @default(false)

  /**
   * ---------------- Discord ----------------
   */
  discordId       String? @unique
  discordName     String?
  discordUser     String?
  discordImage    String?
  discordRewarded Boolean @default(false)

  /**
   * ---------------- Points & rewards ----------------
   */
  points      Int       @default(0)
  lastDailyAt DateTime?

  events PointEvent[]

  /**
   * ---------------- Minted NFTs ----------------
   */
  mints Mint[]

  /**
   * ---------------- Trading ----------------
   */
  holdings     Holding[]
  listings     Listing[]
  tradesSold   Trade[]   @relation("TradeSeller")
  tradesBought Trade[]   @relation("TradeBuyer")

  /**
   * ---------------- Store / delivery / escrow orders ------------
   */
  storeOrdersBought StoreOrder[] @relation("StoreOrderBuyer")
  storeOrdersSold   StoreOrder[] @relation("StoreOrderSeller")

  @@index([twitterUser])
  @@index([discordUser])
  @@index([referralCode])
  @@index([referredById])
}

/**
 * ==========================================================================
 */
/**
 * WALLET NONCE
 */
/**
 * ==========================================================================
 */

model WalletNonce {
  address   String   @id
  nonce     String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/**
 * ==========================================================================
 */
/**
 * POINT EVENTS
 */
/**
 * ==========================================================================
 */

model PointEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String
  points Int
  meta   Json?

  refUserId String?

  @@unique([userId, type, refUserId])
  @@index([userId])
  @@index([type])
}

/**
 * ==========================================================================
 */
/**
 * TEMP STORAGE FOR X OAUTH LINKING
 */
/**
 * ==========================================================================
 */

model TwitterLinkAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sessionToken String

  twitterId    String
  twitterUser  String?
  twitterName  String?
  twitterImage String?

  @@index([sessionToken])
  @@index([createdAt])
  @@index([twitterId])
}

/**
 * ==========================================================================
 */
/**
 * NFT CATALOG ENTRY
 */
/**
 * ==========================================================================
 */

model Mint {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chainId  Int
  contract String
  tokenId  String

  txHash   String? @unique
  tokenUri String?
  name     String?
  image    String?

  verified Boolean @default(true)

  holdings Holding[]
  listings Listing[]
  trades   Trade[]

  @@unique([chainId, contract, tokenId])
  @@index([userId, createdAt])
}

/**
 * ==========================================================================
 */
/**
 * HOLDINGS
 */
/**
 * ==========================================================================
 */

model Holding {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chainId  Int
  contract String
  tokenId  String

  mint Mint @relation(fields: [chainId, contract, tokenId], references: [chainId, contract, tokenId], onDelete: Cascade)

  standard NftStandard
  amount   BigInt      @default(0)

  @@unique([userId, chainId, contract, tokenId])
  @@index([userId])
  @@index([chainId, contract, tokenId])
}

/**
 * ==========================================================================
 */
/**
 * LISTINGS
 */
/**
 * ==========================================================================
 */

model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainId  Int
  contract String
  tokenId  String

  mint Mint @relation(fields: [chainId, contract, tokenId], references: [chainId, contract, tokenId], onDelete: Cascade)

  standard NftStandard

  sellerId String?
  seller   User?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  sellerWallet String
  marketplaceListingId BigInt
  pricePerUnitWei BigInt
  amountTotal     BigInt @default(1)
  amountRemaining BigInt @default(1)

  status      ListingStatus @default(ACTIVE)
  cancelledAt DateTime?
  soldOutAt   DateTime?

  createdTxHash String?

  @@unique([chainId, marketplaceListingId])
  @@index([status])
  @@index([sellerWallet])
  @@index([sellerId])
  @@index([chainId, contract, tokenId])
}

/**
 * ==========================================================================
 */
/**
 * TRADES
 */
/**
 * ==========================================================================
 */

model Trade {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  chainId  Int
  contract String
  tokenId  String

  mint Mint @relation(fields: [chainId, contract, tokenId], references: [chainId, contract, tokenId], onDelete: Cascade)

  standard NftStandard

  txHash   String
  logIndex Int

  blockNum  BigInt
  blockTime DateTime

  marketplaceListingId BigInt?

  sellerWallet String
  buyerWallet  String

  sellerId String?
  seller   User?   @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  buyerId String?
  buyer   User?   @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  amount          BigInt @default(1)
  pricePerUnitWei BigInt
  totalPriceWei   BigInt

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, contract, tokenId, blockTime])
  @@index([sellerWallet])
  @@index([buyerWallet])
}

/**
 * ==========================================================================
 */
/**
 * INDEXER STATE
 */
/**
 * ==========================================================================
 */

model IndexerState {
  id        String   @id @default(cuid())
  chainId   Int
  key       String
  lastBlock BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([chainId, key])
  @@index([chainId, key])
}

/**
 * ==========================================================================
 */
/**
 * REAL MARKETING PRODUCTS
 */
/**
 * ==========================================================================
 */

model RealMarketingProduct {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainId  Int
  contract String
  tokenId  String

  // cafe | store | travel | concert | etc
  vertical String

  creatorWallet       String?
  primarySellerWallet String?
  paymentToken        String?

  tokenUri String?
  name     String?
  image    String?

  maxSupply    BigInt @default(0)
  mintedSupply BigInt @default(0)
  price        BigInt @default(0)

  isActive             Boolean @default(true)
  deliveryEnabled      Boolean @default(false)
  physicalItemIncluded Boolean @default(false)
  officialItem         Boolean @default(false)

  lastTxHash String?

  @@unique([chainId, contract, tokenId])
  @@index([vertical, isActive])
  @@index([contract, tokenId])
  @@index([primarySellerWallet])
  @@index([creatorWallet])
  @@map("real_marketing_products")
}

/**
 * ==========================================================================
 */
/**
 * STORE ORDERS (delivery + escrow flow)
 */
/**
 * ==========================================================================
 */

model StoreOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainId  Int
  contract String
  tokenId  String

  // store | cafe | travel | cosmetics | etc
  vertical String

  buyerWallet  String
  sellerWallet String

  buyerId  String?
  sellerId String?

  buyer  User? @relation("StoreOrderBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  seller User? @relation("StoreOrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  amount     BigInt @default(1)
  unitPrice  BigInt
  totalPrice BigInt

  paymentToken String?

  deliveryRequired Boolean @default(false)
  physicalItem     Boolean @default(false)
  officialItem     Boolean @default(false)

  escrowStatus   EscrowStatus   @default(PENDING)
  deliveryStatus DeliveryStatus @default(PENDING)

  escrowFundedAt   DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  confirmedAt      DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  disputedAt       DateTime?
  cancelledAt      DateTime?

  shippingName    String?
  shippingPhone   String?
  shippingCountry String?
  shippingCity    String?
  shippingAddress String?
  shippingZip     String?

  trackingCode String?
  trackingUrl  String?
  carrier      String?

  buyTxHash            String?
  escrowReleaseTxHash  String?
  escrowRefundTxHash   String?

  noteBuyer  String?
  noteSeller String?
  adminNote  String?

  @@index([buyerWallet])
  @@index([sellerWallet])
  @@index([buyerId])
  @@index([sellerId])
  @@index([chainId, contract, tokenId])
  @@index([vertical])
  @@index([escrowStatus])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@map("store_orders")
}