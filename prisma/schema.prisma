generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Public profile (shareable)
  handle   String? @unique
  publicId String? @unique

  // OAuth identities
  twitterId    String? @unique
  twitterName  String?
  twitterUser  String?
  twitterImage String?

  discordId    String? @unique
  discordName  String?
  discordUser  String?
  discordImage String?

  // Wallet identity (EVM)
  walletAddress String @unique
  walletChainId Int?

  // points
  points      Int       @default(0)
  lastDailyAt DateTime?

  events PointEvent[]

  @@index([twitterUser])
  @@index([discordUser])
}

model WalletNonce {
  address   String   @id  // lowercased
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model PointEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String
  points Int
  meta   Json?

  @@index([userId])
  @@index([type])
}

/**
 * TEMP storage for X OAuth callback data, to link it to the current wallet-user later.
 * This prevents creating a second user for X.
 */
model TwitterLinkAttempt {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())

  // tie to the current NextAuth session cookie
  sessionToken String

  twitterId    String
  twitterUser  String?
  twitterName  String?
  twitterImage String?

  @@index([sessionToken])
  @@index([createdAt])
  @@index([twitterId])
}