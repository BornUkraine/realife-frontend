generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ==========================================================================
 * ENUMS
 * ==========================================================================
 */
enum NftStandard {
  ERC721
  ERC1155
}

enum ListingStatus {
  ACTIVE
  CANCELLED
  SOLD_OUT
}

enum EscrowStatus {
  NOT_REQUIRED
  PENDING
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum DeliveryStatus {
  NOT_REQUIRED
  PENDING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CONFIRMED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

/**
 * --------------------------------------------------------------------------
 * Service-specific lifecycle
 * Used for protected service orders:
 * - digital services
 * - online sessions
 * - local/offline services
 * --------------------------------------------------------------------------
 */
enum ServiceStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  COMPLETED
  CONFIRMED
  CANCELLED
}

enum OrderSourceType {
  STORE
  MARKETPLACE
}

enum OrderKind {
  PRIMARY
  SECONDARY
}

enum MarketType {
  STANDARD
  DELIVERY
  PROTECTED
}

/**
 * --------------------------------------------------------------------------
 * Fulfillment / execution type of the NFT-backed item
 * --------------------------------------------------------------------------
 * PHYSICAL_GOOD   -> physical item with shipping / delivery flow
 * DIGITAL_SERVICE -> digital work, file, design, website, SMM, etc
 * ONLINE_SESSION  -> consultation / lesson / call / online training
 * LOCAL_SERVICE   -> local offline service in city/country
 * --------------------------------------------------------------------------
 */
enum FulfillmentType {
  PHYSICAL_GOOD
  DIGITAL_SERVICE
  ONLINE_SESSION
  LOCAL_SERVICE
}

enum DeliveryMessageRole {
  BUYER
  SELLER
  SUPPORT
  SYSTEM
}

enum SupportRole {
  USER
  MODERATOR
  ADMIN
}

/**
 * --------------------------------------------------------------------------
 * Account authentication architecture
 * --------------------------------------------------------------------------
 * WALLET -> external wallet login through RainbowKit / wagmi
 * GOOGLE -> Google/social login that creates an embedded wallet
 *
 * Important:
 * - X and Discord are NOT login providers in Realife.
 * - X and Discord stay profile/social links only.
 * --------------------------------------------------------------------------
 */
enum AuthMethod {
  WALLET
  GOOGLE
}

enum WalletKind {
  EXTERNAL
  EMBEDDED
}

enum EmbeddedWalletProvider {
  WEB3AUTH
  METAMASK_EMBEDDED
  TURNKEY
  OPENFORT
}

/**
 * --------------------------------------------------------------------------
 * AI generation
 * --------------------------------------------------------------------------
 */
enum AiGenerationType {
  IMAGE
  VIDEO
}

enum AiGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * --------------------------------------------------------------------------
 * AI visual enrichment / NFT search index
 * --------------------------------------------------------------------------
 */
enum AiEnrichmentStatus {
  NONE
  PENDING
  PROCESSING
  DONE
  ERROR
}

/**
 * ==========================================================================
 * USER
 * ==========================================================================
 */
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * ---------------- Public profile ----------------
   */
  handle   String? @unique
  publicId String? @unique

  /**
   * ---------------- Authentication / wallet identity ----------------
   * walletAddress remains the primary onchain address used by holdings,
   * listings, trades and escrow/order flows.
   *
   * Web3 users:
   * - authMethod = WALLET
   * - walletKind = EXTERNAL
   * - walletAddress = connected wallet address
   *
   * Web2 users:
   * - authMethod = GOOGLE
   * - walletKind = EMBEDDED
   * - embeddedWalletProvider = WEB3AUTH, METAMASK_EMBEDDED, TURNKEY or OPENFORT
   * - walletAddress = generated embedded wallet address
   *
   * Realife never stores seed phrases or private keys.
   */
  authMethod AuthMethod @default(WALLET)
  walletKind WalletKind @default(EXTERNAL)

  walletAddress String @unique
  walletChainId Int?

  embeddedWalletProvider EmbeddedWalletProvider?

  /**
   * ---------------- Login / security telemetry ----------------
   * IP is NOT the primary user identifier.
   * It is only an anti-fraud / admin-risk signal.
   */
  firstLoginAt DateTime?
  lastLoginAt  DateTime?

  firstIp        String?
  lastIp         String?
  firstUserAgent String? @db.Text
  lastUserAgent  String? @db.Text

  firstCountry String?
  lastCountry  String?
  firstRegion  String?
  lastRegion   String?
  firstCity    String?
  lastCity     String?

  lastAuthMethod             AuthMethod?
  lastWalletKind             WalletKind?
  lastEmbeddedWalletProvider EmbeddedWalletProvider?

  /**
   * Optional display metadata from a social/embedded wallet provider.
   * Do not treat these fields as the source of wallet ownership.
   * Wallet ownership is still proven by signing the Realife nonce.
   */
  googleId    String?
  googleEmail String?
  googleName  String?
  googleImage String?

  /**
   * ---------------- Site support/admin role ----------------
   */
  supportRole SupportRole @default(USER)

  /**
   * ---------------- Delivery / VIP seller access ----------------
   */
  approvedPhysicalSeller Boolean   @default(false)
  approvedPhysicalAt     DateTime?
  approvedPhysicalNote   String?

  /**
   * ---------------- Referrals ----------------
   */
  referralCode String?   @unique
  referredById String?
  referredAt   DateTime?

  referredBy User?  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  User[] @relation("UserReferrals")

  /**
   * ---------------- X (Twitter) ----------------
   */
  twitterId       String? @unique
  twitterName     String?
  twitterUser     String?
  twitterImage    String?
  twitterRewarded Boolean @default(false)

  /**
   * ---------------- Discord ----------------
   */
  discordId       String? @unique
  discordName     String?
  discordUser     String?
  discordImage    String?
  discordRewarded Boolean @default(false)

  /**
   * ---------------- Points & rewards ----------------
   */
  points      Int          @default(0)
  lastDailyAt DateTime?
  events      PointEvent[]

  /**
   * ---------------- Minted NFTs ----------------
   */
  mints Mint[]

  /**
   * ---------------- Trading ----------------
   */
  holdings     Holding[]
  listings     Listing[]
  tradesSold   Trade[]   @relation("TradeSeller")
  tradesBought Trade[]   @relation("TradeBuyer")

  /**
   * ---------------- Store / delivery / escrow orders ------------
   */
  storeOrdersBought StoreOrder[] @relation("StoreOrderBuyer")
  storeOrdersSold   StoreOrder[] @relation("StoreOrderSeller")

  /**
   * ---------------- AI generations ----------------
   */
  aiGenerations AiGeneration[]

  /**
   * ---------------- Identity/security relations ----------------
   */
  wallets     UserWallet[]
  loginEvents UserLoginEvent[]

  @@index([authMethod])
  @@index([walletKind])
  @@index([embeddedWalletProvider])
  @@index([googleEmail])
  @@index([twitterUser])
  @@index([discordUser])
  @@index([referralCode])
  @@index([referredById])
  @@index([approvedPhysicalSeller])
  @@index([supportRole])
  @@index([firstIp])
  @@index([lastIp])
  @@index([lastLoginAt])
  @@index([lastCountry])
}

/**
 * ==========================================================================
 * USER LINKED WALLETS
 * ==========================================================================
 * Keeps the old User.walletAddress as the primary address, while allowing
 * Realife to add/swap embedded wallet providers later. This is important for
 * MetaMask Embedded -> Turnkey migration or for users who link an external
 * wallet after Google login.
 */
model UserWallet {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address String
  chainId Int?

  kind                   WalletKind @default(EXTERNAL)
  embeddedWalletProvider EmbeddedWalletProvider?

  isPrimary Boolean @default(false)
  label     String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  lastIp        String?
  lastUserAgent String? @db.Text

  @@unique([userId, address])
  @@index([address])
  @@index([userId])
  @@index([kind])
  @@index([embeddedWalletProvider])
  @@index([isPrimary])
  @@index([lastSeenAt])
}

/**
 * ==========================================================================
 * USER LOGIN / SESSION EVENTS
 * ==========================================================================
 * Admin/security history for Google/Web2 embedded wallet users and Web3 users.
 * IP + userAgent are signals only; never use them as the primary identity.
 */
model UserLoginEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventType String @default("SESSION_CHECK")

  walletAddress String?
  walletChainId  Int?

  authMethod             AuthMethod?
  walletKind             WalletKind?
  embeddedWalletProvider EmbeddedWalletProvider?

  googleId    String?
  googleEmail String?

  ip        String?
  userAgent String? @db.Text

  country String?
  region  String?
  city    String?

  referrer String? @db.Text
  path     String? @db.Text

  @@index([userId])
  @@index([createdAt])
  @@index([eventType])
  @@index([walletAddress])
  @@index([googleEmail])
  @@index([ip])
  @@index([country])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

/**
 * ==========================================================================
 * WALLET NONCE
 * ==========================================================================
 */
model WalletNonce {
  address   String   @id
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/**
 * ==========================================================================
 * POINT EVENTS
 * ==========================================================================
 */
model PointEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  points    Int
  meta      Json?
  refUserId String?

  @@unique([userId, type, refUserId])
  @@index([userId])
  @@index([type])
}

/**
 * ==========================================================================
 * TEMP STORAGE FOR X OAUTH LINKING
 * ==========================================================================
 */
model TwitterLinkAttempt {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  sessionToken String
  twitterId    String
  twitterUser  String?
  twitterName  String?
  twitterImage String?

  @@index([sessionToken])
  @@index([createdAt])
  @@index([twitterId])
}

/**
 * ==========================================================================
 * NFT CATALOG ENTRY
 * ==========================================================================
 */
model Mint {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chainId  Int
  contract String
  tokenId  String

  txHash   String? @unique
  tokenUri String?
  name     String?
  image    String?

  verified Boolean @default(true)

  /**
   * ---------------- Delivery / physical item flags ----------------
   */
  deliveryEnabled      Boolean @default(false)
  physicalItemIncluded Boolean @default(false)
  officialItem         Boolean @default(false)

  /**
   * ---------------- Fulfillment / category metadata ---------------
   * Used by PROTECTED marketplace and category filters in trading
   */
  fulfillmentType FulfillmentType?
  category        String?
  subcategory     String?

  /**
   * ---------------- Local / offline service location ---------------
   * Used only when fulfillmentType = LOCAL_SERVICE
   * Example: fitness trainer in Los Angeles, electrician in Kyiv, tour in Paris
   */
  serviceCountry String?
  serviceCity    String?
  serviceArea    String?

  /**
   * ---------------- Metadata cache (from IPFS tokenUri) -----------
   * Populated lazily by the API layer on first request, or eagerly
   * by scripts/backfill-metadata.mjs.
   * All nullable — if metadataCachedAt is null, row has never been
   * resolved and the API will attempt a fetch on next read.
   * metaMediaKind is "image" | "video" (not enforced at DB level to
   * keep it painless to evolve).
   */
  metadataCachedAt DateTime?
  metaImage        String?   @db.Text
  metaAnimation    String?   @db.Text
  metaMediaKind    String?
  metaDescription  String?   @db.Text
  metaCollection   String?
  metaItem         String?
  metaRarity       String?
  metaBrand        String?
  metaProject      String?

  holdings Holding[]
  listings Listing[]
  trades   Trade[]

  /**
   * ---------------- AI visual search index ------------------------
   * Optional searchable AI layer for visual text, detected product,
   * service, region, city and tags extracted from NFT image/poster.
   */
  aiIndex NftAiIndex?

  @@unique([chainId, contract, tokenId])
  @@index([userId, createdAt])
  @@index([chainId, contract, tokenId])
  @@index([deliveryEnabled, physicalItemIncluded])
  @@index([fulfillmentType])
  @@index([category, subcategory])
  @@index([fulfillmentType, serviceCountry, serviceCity])
  @@index([serviceCountry, serviceCity])
  @@index([metadataCachedAt])
  @@index([verified, chainId, contract])
}

/**
 * ==========================================================================
 * HOLDINGS
 * ==========================================================================
 */
model Holding {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chainId  Int
  contract String
  tokenId  String

  mint Mint @relation(fields: [chainId, contract, tokenId], references: [chainId, contract, tokenId], onDelete: Cascade)

  standard NftStandard
  amount   BigInt      @default(0)

  @@unique([userId, chainId, contract, tokenId])
  @@index([userId])
  @@index([chainId, contract, tokenId])
}

/**
 * ==========================================================================
 * LISTINGS
 * ==========================================================================
 */
model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainId  Int
  contract String
  tokenId  String

  mint Mint @relation(fields: [chainId, contract, tokenId], references: [chainId, contract, tokenId], onDelete: Cascade)

  standard NftStandard

  sellerId String?
  seller   User?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  /**
   * STANDARD  = old normal marketplace
   * DELIVERY  = old delivery escrow marketplace
   * PROTECTED = new hybrid protected escrow marketplace
   */
  marketType MarketType @default(STANDARD)

  /**
   * specific marketplace contract address
   */
  marketplaceContract String?

  /**
   * Payment token snapshot for the listing.
   * For legacy ETH listings these fields can stay null.
   * For USDC protected listings:
   * - paymentTokenAddress = Circle testnet USDC on Base Sepolia
   * - paymentSymbol = "USDC"
   * - paymentDecimals = 6
   *
   * Keep pricePerUnitWei as the existing raw amount column for now.
   * In USDC flow it stores USDC raw units, e.g. 10 USDC = 10000000.
   */
  paymentTokenAddress String?
  paymentSymbol       String?
  paymentDecimals     Int?

  sellerWallet         String
  marketplaceListingId BigInt
  pricePerUnitWei      BigInt
  amountTotal          BigInt @default(1)
  amountRemaining      BigInt @default(1)

  /**
   * ---------------- Snapshot of delivery / physical state at listing time ---
   */
  deliveryEnabled      Boolean @default(false)
  physicalItemIncluded Boolean @default(false)
  officialItem         Boolean @default(false)

  /**
   * ---------------- Snapshot of protected/service classification ------------
   */
  fulfillmentType FulfillmentType?
  category        String?
  subcategory     String?

  /**
   * ---------------- Snapshot of local / offline service location ------------
   */
  serviceCountry String?
  serviceCity    String?
  serviceArea    String?

  status        ListingStatus @default(ACTIVE)
  cancelledAt   DateTime?
  soldOutAt     DateTime?
  createdTxHash String?

  /**
   * ---------------- Admin safety / moderation ----------------------------
   * adminHidden protects Realife users from fake, prohibited, empty or unsafe
   * listings. Keep marketplace APIs/indexers from re-activating rows with this
   * flag unless an ADMIN explicitly restores them.
   */
  adminHidden         Boolean   @default(false)
  adminHiddenAt       DateTime?
  adminHiddenByUserId String?
  adminHiddenByWallet String?
  adminHiddenReason   String?
  adminHiddenNote     String?   @db.Text

  @@unique([chainId, marketType, marketplaceListingId])
  @@index([status])
  @@index([adminHidden])
  @@index([sellerWallet])
  @@index([sellerId])
  @@index([chainId, contract, tokenId])
  @@index([deliveryEnabled, physicalItemIncluded])
  @@index([marketType])
  @@index([marketplaceContract])
  @@index([paymentTokenAddress])
  @@index([paymentSymbol])
  @@index([marketType, marketplaceListingId])
  @@index([marketplaceContract, marketplaceListingId])
  @@index([fulfillmentType])
  @@index([category, subcategory])
  @@index([fulfillmentType, serviceCountry, serviceCity])
  @@index([serviceCountry, serviceCity])
}

/**
 * ==========================================================================
 * TRADES
 * ==========================================================================
 */
model Trade {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  chainId  Int
  contract String
  tokenId  String

  mint Mint @relation(fields: [chainId, contract, tokenId], references: [chainId, contract, tokenId], onDelete: Cascade)

  standard NftStandard

  txHash    String
  logIndex  Int
  blockNum  BigInt
  blockTime DateTime

  marketplaceListingId  BigInt?
  marketplacePurchaseId BigInt?

  marketType MarketType @default(STANDARD)

  marketplaceContract String?

  /**
   * Payment token snapshot for the trade/order event.
   * For legacy ETH/spot trades these fields can stay null.
   * For USDC protected trades:
   * - paymentTokenAddress = Circle testnet USDC on Base Sepolia
   * - paymentSymbol = "USDC"
   * - paymentDecimals = 6
   *
   * Keep pricePerUnitWei / totalPriceWei as existing raw amount columns.
   * In USDC flow they store USDC raw units, e.g. 10 USDC = 10000000.
   */
  paymentTokenAddress String?
  paymentSymbol       String?
  paymentDecimals     Int?

  /**
   * ---------------- Snapshot of protected/service classification ------------
   */
  fulfillmentType FulfillmentType?
  category        String?
  subcategory     String?

  /**
   * ---------------- Snapshot of local / offline service location ------------
   */
  serviceCountry String?
  serviceCity    String?
  serviceArea    String?

  sellerWallet String
  buyerWallet  String

  sellerId String?
  seller   User?   @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  buyerId String?
  buyer   User?   @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  amount          BigInt @default(1)
  pricePerUnitWei BigInt
  totalPriceWei   BigInt

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, contract, tokenId, blockTime])
  @@index([sellerWallet])
  @@index([buyerWallet])
  @@index([marketplaceListingId])
  @@index([marketplacePurchaseId])
  @@index([marketType])
  @@index([marketplaceContract])
  @@index([paymentTokenAddress])
  @@index([paymentSymbol])
  @@index([marketType, marketplaceListingId])
  @@index([marketType, marketplacePurchaseId])
  @@index([marketplaceContract, marketplaceListingId])
  @@index([marketplaceContract, marketplacePurchaseId])
  @@index([fulfillmentType])
  @@index([category, subcategory])
  @@index([fulfillmentType, serviceCountry, serviceCity])
  @@index([serviceCountry, serviceCity])
}

/**
 * ==========================================================================
 * INDEXER STATE
 * ==========================================================================
 */
model IndexerState {
  id        String   @id @default(cuid())
  chainId   Int
  key       String
  lastBlock BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([chainId, key])
  @@index([chainId, key])
}

/**
 * ==========================================================================
 * REAL MARKETING PRODUCTS
 * ==========================================================================
 */
model RealMarketingProduct {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainId  Int
  contract String
  tokenId  String

  // cafe | store | travel | concert | etc
  vertical String

  creatorWallet       String?
  primarySellerWallet String?
  paymentToken        String?

  tokenUri String?
  name     String?
  image    String?

  maxSupply    BigInt @default(0)
  mintedSupply BigInt @default(0)
  price        BigInt @default(0)

  isActive Boolean @default(true)

  deliveryEnabled      Boolean @default(false)
  physicalItemIncluded Boolean @default(false)
  officialItem         Boolean @default(false)

  lastTxHash String?

  @@unique([chainId, contract, tokenId])
  @@index([vertical, isActive])
  @@index([contract, tokenId])
  @@index([primarySellerWallet])
  @@index([creatorWallet])
  @@map("real_marketing_products")
}

/**
 * ==========================================================================
 * STORE ORDERS (delivery + escrow flow)
 * ==========================================================================
 */
model StoreOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainId  Int
  contract String
  tokenId  String

  /**
   * Source of order:
   * STORE -> buy from store/cafe/etc
   * MARKETPLACE -> secondary sale from trading
   */
  sourceType OrderSourceType @default(STORE)

  /**
   * PRIMARY -> direct primary sale
   * SECONDARY -> resale / trading sale
   */
  orderKind OrderKind @default(PRIMARY)

  /**
   * store | cafe | travel | cosmetics | marketplace | etc
   */
  vertical String

  /**
   * STANDARD  = old normal marketplace
   * DELIVERY  = old delivery escrow marketplace
   * PROTECTED = new hybrid protected escrow marketplace
   * In PROTECTED hybrid flow:
   * - buyer receives NFT immediately on buy
   * - funds stay in escrow
   * - refund requires NFT return back to escrow contract
   */
  marketType MarketType @default(STANDARD)

  marketplaceContract String?

  buyerWallet  String
  sellerWallet String

  buyerId  String?
  sellerId String?

  buyer  User? @relation("StoreOrderBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  seller User? @relation("StoreOrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  /**
   * Optional links to marketplace entities
   */
  listingId             String?
  tradeId               String? @unique
  marketplaceListingId  BigInt?
  marketplacePurchaseId BigInt?

  amount     BigInt @default(1)
  unitPrice  BigInt
  totalPrice BigInt

  /**
   * Payment token used for the order.
   * Existing paymentToken can continue to store token/native address.
   * For USDC protected orders, paymentToken should be the USDC contract address,
   * paymentSymbol = "USDC", paymentDecimals = 6.
   */
  paymentToken    String?
  paymentSymbol   String?
  paymentDecimals Int?

  deliveryRequired Boolean @default(false)
  physicalItem     Boolean @default(false)
  officialItem     Boolean @default(false)

  /**
   * ---------------- Protected/service execution metadata --------------------
   */
  fulfillmentType FulfillmentType?
  serviceStatus   ServiceStatus    @default(NOT_REQUIRED)

  /**
   * ---------------- Catalog / trading filters ------------------------------
   */
  category    String?
  subcategory String?

  /**
   * ---------------- Local / offline service location ------------------------
   * This is NOT buyer shipping address.
   * This is where the seller provides an offline/local service.
   */
  serviceCountry String?
  serviceCity    String?
  serviceArea    String?

  escrowStatus   EscrowStatus   @default(PENDING)
  deliveryStatus DeliveryStatus @default(PENDING)

  escrowFundedAt DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  confirmedAt    DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  disputedAt     DateTime?
  cancelledAt    DateTime?

  /**
   * ---------------- Hybrid protected refund / confirm fields ---------------
   */
  buyerConfirmedAt  DateTime?
  refundRequestedAt DateTime?
  nftReturnedAt     DateTime?
  refundRejectedAt  DateTime?

  /**
   * ---------------- Service-specific timing fields -------------------------
   */
  scheduledFor        DateTime?
  workStartedAt       DateTime?
  submittedAt         DateTime?
  revisionRequestedAt DateTime?
  completedAt         DateTime?

  shippingName    String?
  shippingPhone   String?
  shippingCountry String?
  shippingCity    String?
  shippingAddress String?
  shippingZip     String?

  trackingCode String?
  trackingUrl  String?
  carrier      String?

  buyTxHash           String?
  escrowReleaseTxHash String?
  escrowRefundTxHash  String?

  noteBuyer  String?
  noteSeller String?
  adminNote  String?

  deliveryMessages   DeliveryMessage[]
  adminNotifications AdminNotification[]

  @@unique([chainId, marketType, marketplaceContract, marketplacePurchaseId])
  @@index([buyerWallet])
  @@index([sellerWallet])
  @@index([buyerId])
  @@index([sellerId])
  @@index([chainId, contract, tokenId])
  @@index([vertical])
  @@index([sourceType, orderKind])
  @@index([listingId])
  @@index([tradeId])
  @@index([marketplaceListingId])
  @@index([marketplacePurchaseId])
  @@index([escrowStatus])
  @@index([deliveryStatus])
  @@index([serviceStatus])
  @@index([createdAt])
  @@index([marketType])
  @@index([marketplaceContract])
  @@index([paymentToken])
  @@index([paymentSymbol])
  @@index([marketType, marketplaceListingId])
  @@index([marketType, marketplacePurchaseId])
  @@index([marketplaceContract, marketplaceListingId])
  @@index([marketplaceContract, marketplacePurchaseId])
  @@index([fulfillmentType])
  @@index([category, subcategory])
  @@index([fulfillmentType, serviceCountry, serviceCity])
  @@index([serviceCountry, serviceCity])
  @@index([buyTxHash])
  @@index([escrowReleaseTxHash])
  @@index([escrowRefundTxHash])
  @@map("store_orders")
}

/**
 * ==========================================================================
 * DELIVERY CHAT / ORDER ROOM MESSAGES
 * ==========================================================================
 */
model DeliveryMessage {
  id      String @id @default(cuid())
  orderId String

  senderUserId String?
  senderWallet String?
  senderRole   DeliveryMessageRole

  body       String
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("delivery_messages")
}




/**
 * ===========================================================================
 * ADMIN NOTIFICATIONS
 * ===========================================================================
 * Persistent inbox for support/moderation alerts.
 * Example: buyer/seller presses Admin Support inside an order room.
 */
model AdminNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type     String
  status   String   @default("UNREAD") // UNREAD | READ | RESOLVED
  priority String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT

  title String
  body  String @db.Text

  orderId String?
  order   StoreOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveryMessageId String?

  actorUserId String?
  actorWallet String?
  actorRole   DeliveryMessageRole?

  readAt       DateTime?
  resolvedAt   DateTime?
  resolvedById String?
  resolvedByWallet String?

  metadata Json?

  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([orderId])
  @@index([actorWallet])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("admin_notifications")
}

/**
 * ===========================================================================
 * ADMIN / SAFETY AUDIT LOG
 * ===========================================================================
 * Immutable-ish operational log for moderator/admin actions.
 * Used for escrow decisions, listing removals, NFT safety actions,
 * support notes and future moderation review.
 */
model AdminActionLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  adminUserId String?
  adminWallet String?
  adminRole   SupportRole?

  action     String
  targetType String
  targetId   String?

  reason   String?
  note     String? @db.Text
  metadata Json?

  @@index([adminUserId])
  @@index([adminWallet])
  @@index([adminRole])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_action_logs")
}

/**
 * ==========================================================================
 * AI GENERATIONS
 * ==========================================================================
 */
model AiGeneration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type   AiGenerationType
  status AiGenerationStatus @default(PENDING)

  provider String?
  model    String?

  prompt         String  @db.Text
  negativePrompt String? @db.Text

  quality     String?
  aspectRatio String?
  size        String?
  durationSec Int?

  sourceImageUrl String? @db.Text
  previewUrl     String? @db.Text
  resultUrl      String? @db.Text

  externalJobId String?
  mimeType      String?
  fileSize      Int?

  errorMessage String? @db.Text

  /**
   * Optional business usage flags
   */
  usedInListing Boolean @default(false)
  usedInService Boolean @default(false)
  mintedAsNft   Boolean @default(false)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([externalJobId])
  @@map("ai_generations")
}

/**
 * ==========================================================================
 * NFT AI VISUAL SEARCH INDEX
 * ==========================================================================
 * Stores AI-enriched visual/search data extracted from NFT image/poster/video.
 * This is NOT immutable NFT metadata. This is a searchable DB index layer.
 * Example:
 * - visualText: "PREMIUM PINEAPPLES Spain Andalusia Phone..."
 * - detectedProduct: "Pineapples"
 * - detectedCountry: "Spain"
 * - detectedRegion: "Andalusia"
 * - searchTags: ["pineapple", "fruit", "Spain", "Andalusia", "food"]
 */
model NftAiIndex {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chainId  Int
  contract String
  tokenId  String

  mint Mint @relation(fields: [chainId, contract, tokenId], references: [chainId, contract, tokenId], onDelete: Cascade)

  status AiEnrichmentStatus @default(PENDING)

  visualText    String? @db.Text
  visualSummary String? @db.Text

  detectedProduct  String?
  detectedService  String?
  detectedCategory String?
  detectedBrand    String?

  detectedCountry String?
  detectedRegion  String?
  detectedCity    String?
  detectedArea    String?

  searchTags String[] @default([])

  confidence Float?

  sourceImage     String? @db.Text
  sourceAnimation String? @db.Text

  provider String?
  model    String?

  error String? @db.Text

  enrichedAt DateTime?

  @@unique([chainId, contract, tokenId])
  @@index([chainId, contract])
  @@index([status, updatedAt])
  @@index([detectedCountry])
  @@index([detectedRegion])
  @@index([detectedCity])
  @@index([detectedCategory])
  @@index([detectedProduct])
  @@index([detectedService])
  @@index([enrichedAt])
  @@map("nft_ai_index")
}